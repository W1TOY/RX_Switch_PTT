(footprint "RCA_Jack_SameSky_RCJ-01x_Horizontal"
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "RCA (phono) jack, right angle, through hole, Same Sky (CUI) RCJ-01x (RCJ-011 black ... RCJ-017 orange). Recommended PCB layout per datasheet rev 1.06: center contact 1.7 mm hole, shell 3x 2.6 mm holes (two on a 10.00 mm row with the center pin, one 4.50 mm toward the plug opening). Shell box 11.0 mm wide; put the shell front (y = -7.5) on the board edge so the 8.3 mm barrel protrudes ~4.5 mm through a ~9.5 mm hole in a 2 mm panel. Also fits generic metal-shell RCA jacks of this style (e.g. uxcell) - verify hole pattern on a sample. https://www.sameskydevices.com/product/resource/rcj-01.pdf")
	(tags "RCA phono cinch jack RCJ-01")
	(property "Reference" "REF**" (at 0 4.2 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "RCA_Jack_SameSky_RCJ-01x_Horizontal" (at 0 -13.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(property "Datasheet" "https://www.sameskydevices.com/product/resource/rcj-01.pdf" (at 0 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1 1) (thickness 0.15))))
	(property "Description" "RCA jack RCJ-01x" (at 0 0 0) (layer "F.Fab") (hide yes) (effects (font (size 1 1) (thickness 0.15))))
	(attr through_hole)
	(fp_rect (start -5.5 -7.5) (end 5.5 2.5) (stroke (width 0.1) (type default)) (fill no) (layer "F.Fab"))
	(fp_rect (start -4.15 -12) (end 4.15 -7.5) (stroke (width 0.1) (type default)) (fill no) (layer "F.Fab"))
	(fp_line (start -7 -7.5) (end 7 -7.5) (stroke (width 0.1) (type dash)) (layer "F.Fab"))
	(fp_text user "board edge (barrel protrudes)" (at 0 -8.2 0) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.09))))
	(fp_line (start -5.62 2.62) (end 5.62 2.62) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
	(fp_line (start -5.62 2.62) (end -5.62 2.15) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
	(fp_line (start 5.62 2.62) (end 5.62 2.15) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
	(fp_line (start -5.62 -2.15) (end -5.62 -7.0) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
	(fp_line (start 5.62 -2.15) (end 5.62 -7.0) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
	(fp_rect (start -6.1 -12.5) (end 6.1 3.1) (stroke (width 0.05) (type default)) (fill no) (layer "F.CrtYd"))
	(fp_text user "${REFERENCE}" (at 0 -2 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(pad "1" thru_hole circle (at 0 0) (size 2.7 2.7) (drill 1.7) (layers "*.Cu" "*.Mask") (pinfunction "In") (pintype "passive"))
	(pad "2" thru_hole circle (at -5 0) (size 3.6 3.6) (drill 2.6) (layers "*.Cu" "*.Mask") (pinfunction "Ext") (pintype "passive"))
	(pad "2" thru_hole circle (at 5 0) (size 3.6 3.6) (drill 2.6) (layers "*.Cu" "*.Mask") (pinfunction "Ext") (pintype "passive"))
	(pad "2" thru_hole circle (at 0 -4.5) (size 3.6 3.6) (drill 2.6) (layers "*.Cu" "*.Mask") (pinfunction "Ext") (pintype "passive"))
	(embedded_fonts no)
